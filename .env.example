# TraderOS — Environment Variable Reference
# Copy this file to .env and fill in your values.
# Secrets live here or in a secret manager (Vault) — never in settings.yaml.

# --- Trading mode ---
# paper | live | backtest (default: paper)
# TRADING_MODE="paper"

# Production posture: "production" arms the sealed security policy (requires
# keys + TLS posture). Leave unset for development/CI.
# TRADEROS_ENV="production"
# True when a PaaS edge (Railway) terminates TLS and forwards HTTP to the app.
# TLS_TERMINATED_BY_PROXY="true"

# --- Database ---
# SQLite path (default: data/trader.db), or DATABASE_URL for Postgres.
# DB_PATH="data/trader.db"
# DATABASE_URL="postgresql://user:pass@host:5432/traderos"

# --- Automatic database backups (Sprint 48) ---
# The orchestrator backs up the configured DB on a timer (Postgres via pg_dump
# when DATABASE_URL is set). Failures are surfaced on /v1/orchestrator/status
# and on-call, never silent. Leave unset on local/CI so nothing backs up
# unintentionally; arm on the deployed service.
# DB_BACKUP_INTERVAL_SECONDS="3600"
# DB_BACKUP_DIR="backups"
# DB_MAX_BACKUPS="30"

# --- Operator auth (role-scoped API keys; fail-closed in production) ---
# TRADEROS_ADMIN_API_KEY="long-random"
# TRADEROS_OPERATOR_API_KEY="long-random"
# TRADEROS_VIEWER_API_KEY="long-random"
# Seed the operator session-login account on first boot:
# TRADEROS_ADMIN_USERNAME="operator"
# TRADEROS_ADMIN_PASSWORD="strong-password"

# --- Market data ---
# Enable the real Binance REST collector (env override beats settings.yaml).
# Keep off by default so CI/tests stay network-free.
# BINANCE_ENABLED="true"
# Enable the live Binance WebSocket tick feed aggregated into candles.
# Requires BINANCE_ENABLED=true and the websockets package.
# BINANCE_STREAMING="true"

# --- Paper / backtest ---
# DEFAULT_CASH="10000.0"

# --- Logging ---
# LOG_LEVEL="INFO"
# LOG_FILE="logs/traderos.log"

# --- Broker (Alpaca) ---
# ALPACA_API_KEY="your_alpaca_api_key"
# ALPACA_SECRET_KEY="your_alpaca_secret_key"
# ALPACA_PAPER="true"     # true = paper endpoint, false = live endpoint

# --- Risk rails (env overrides; LIVE refuses to arm without explicit values) ---
# RISK_DAILY_LOSS_PCT="0.02"
# RISK_MAX_POSITION_SIZE="10000.0"
# RISK_MAX_POSITIONS_TOTAL="10"
# RISK_MAX_GROSS_EXPOSURE="0.5"
# RISK_MAX_DATA_STALENESS_SECONDS="300"
# RISK_ALLOWED_MARKETS="BTCUSDT,ETHUSDT"

# --- Notification / on-call ---
# WEBHOOK_URL="https://hooks.example.com/traderos"
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
# PAGERDUTY_ROUTING_KEY="..."
# ONCALL_WEBHOOK_URL="..."

# --- API / dashboard ---
# CORS_ORIGINS="https://traderos-production.up.railway.app,http://localhost:3000"
# RATE_LIMIT_MAX="100"
# ORCHESTRATOR_READY_TIMEOUT="5.0"

# --- Secret manager (preferred for live keys) ---
# VAULT_ADDR="http://vault:8200"
# VAULT_TOKEN="..."
